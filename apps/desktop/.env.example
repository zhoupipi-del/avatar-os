# ============================================================
# 桌面智能体 × WINGS 对接端口 — 配置模板
# ------------------------------------------------------------
# 本文件仅作用于「可选参考适配器」：
#   src/integration-port/adapters/wings.ts
# 该适配器默认【不加载】，不参与生产构建。
# 重新融合时：复制为 .env 并填写，再显式启用适配器。
# ============================================================

# 是否走本地 mock 假报警（true 时无需 JWT 即可验证端口贯通）
VITE_WINGS_MOCK=true

# WINGS API 基地址（含 /api/v1）
VITE_WINGS_API_BASE=https://lijiangschool.online/api/v1

# 教师账号 JWT（用于 Authorization: Bearer <token>）
# mock=true 时可留空
VITE_WINGS_TOKEN=

# REST 端点路径已写在参考适配器内，如需变更直接改适配器：
#   全校 RDI 摘要   GET {API_BASE}/reports/rdi-summary
#   危机学生看板   GET {API_BASE}/risk_models/dashboard
#   学生名册       GET {API_BASE}/student_registry/students
#   SSE 实时预警   GET {API_BASE}/notifications/stream   （Bearer 鉴权，事件名 COMPOSITE_ALERT）

# 本地 LLM（接主机已运行的 Ollama，免打包；敏感内容不出本机）
# 仅参考适配器内 draftWithOllama() 使用
VITE_OLLAMA_URL=http://127.0.0.1:11434
VITE_OLLAMA_MODEL=deepseek-r1:8b
