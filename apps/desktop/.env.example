# ============================================================
# 桌面智能体 × WINGS 对接端口 — 配置模板
# ------------------------------------------------------------
# 本文件仅作用于「可选参考适配器」：
#   src/integration-port/adapters/wings.ts
# 该适配器默认【不加载】，不参与生产构建。
# 重新融合时：复制为 .env 并填写，再显式启用适配器。
# ============================================================

# 是否走本地 mock 假报警（true 时无需 JWT 即可验证端口贯通）
VITE_WINGS_MOCK=true

# WINGS API 基地址（含 /api/v1）
VITE_WINGS_API_BASE=https://lijiangschool.online/api/v1

# 教师账号 JWT（用于 Authorization: Bearer <token>）
# mock=true 时可留空
VITE_WINGS_TOKEN=

# REST 端点路径已写在参考适配器内，如需变更直接改适配器：
#   全校 RDI 摘要   GET {API_BASE}/reports/rdi-summary
#   危机学生看板   GET {API_BASE}/risk_models/dashboard
#   学生名册       GET {API_BASE}/student_registry/students
#   SSE 实时预警   GET {API_BASE}/notifications/stream   （Bearer 鉴权，事件名 COMPOSITE_ALERT）

# 本地 LLM（WINGS 参考适配器内 draftWithOllama() 使用；与下方 VOID 大脑配置相互独立）
VITE_OLLAMA_URL=http://127.0.0.1:11434

# ============================================================
# 陪伴模式（v0.4.0）—— 这些是"出厂默认值"，会被打包进安装包；
# 对方在 ⚙ 设置里改过的值优先（除非开启锁定）。
# 建议：复制本文件为 apps/desktop/.env.local 再填写（.env.local 不会被提交）。
# ============================================================
# cloud（云端大模型）| ollama（本机）| rule（离线固定回复）
# 不填时：填了 VITE_CLOUD_API_KEY 就是 cloud，否则 ollama
VITE_AVATAROS_BRAIN_MODE=cloud
# deepseek | qwen | custom
VITE_CLOUD_PRESET=deepseek
# ⚠️ Key 会被打包进安装包，能被懂行的人提取：务必在厂商后台设置消费上限，只用于自己送人的版本
VITE_CLOUD_API_KEY=
# 留空则使用预设的地址 / 模型
VITE_CLOUD_BASE_URL=
VITE_CLOUD_MODEL=

# 你的名字（输入框会显示"和 XX 说句话"）、你怎么称呼她
VITE_COMPANION_NAME=
VITE_COMPANION_NICKNAME=
# 主动陪伴：开关、最少间隔分钟、安静时段（整点，0 到 8 表示 0:00–8:00 不主动说话）
VITE_COMPANION_PROACTIVE=true
VITE_COMPANION_PROACTIVE_MINUTES=45
VITE_COMPANION_QUIET_START=0
VITE_COMPANION_QUIET_END=8
# true：设置里隐藏 Key / 人设 / 声音，且只认这里的值（送人用，对方只管聊）
VITE_COMPANION_LOCK_SETTINGS=false

# ============================================================
# 你的声音（云端克隆，默认硅基流动 CosyVoice2；不填则用 Windows 系统语音）
# ============================================================
# 先在 ⚙ → 声音 里上传录音克隆好、试听满意，再把「音色」那一栏的 speech:... 抄到这里
# clone = 用你的声音；system = 系统语音；不填时：Key 和音色都填了就是 clone
VITE_VOICE_MODE=
VITE_VOICE_API_KEY=
VITE_VOICE_ID=
# 留空用默认：https://api.siliconflow.cn/v1 + FunAudioLLM/CosyVoice2-0.5B
VITE_VOICE_BASE_URL=
VITE_VOICE_MODEL=

# ============================================================
# 本机 Ollama（VITE_AVATAROS_BRAIN_MODE=ollama 时使用）
# ============================================================
# 用 127.0.0.1 而非 localhost（Windows 上 localhost 可能先解析 IPv6 导致连不上）
# 改成其他地址时，需同步修改 src-tauri/capabilities/default.json 的 http:default 放行范围
VITE_OLLAMA_ENDPOINT=http://127.0.0.1:11434
# 对话与主动说话共用；资源紧张可用 qwen2.5:0.5b
VITE_OLLAMA_MODEL=qwen2.5:7b
